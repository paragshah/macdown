#!/usr/bin/env bash
# mdview - open a Markdown file in the local Markdown Viewer web app.
#
# Usage: mdview <file.md>
#
# Starts a tiny static HTTP server rooted at the app directory, exposes the
# target file to it via a temporary symlink, and opens the browser pointed at
# index.html?src=<file>. The server runs in the background and detaches from
# this terminal; the script prints its PID and the command to stop it.

set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${MDVIEW_PORT:-8753}"

if [[ $# -lt 1 ]]; then
  echo "Usage: mdview <file.md>" >&2
  exit 1
fi

SRC="$1"
if [[ ! -f "$SRC" ]]; then
  echo "mdview: no such file: $SRC" >&2
  exit 1
fi

ABS="$(cd "$(dirname "$SRC")" && pwd)/$(basename "$SRC")"

# Expose the file to the server via a symlink inside a dedicated subfolder.
DOCS_DIR="$APP_DIR/.mdview-docs"
mkdir -p "$DOCS_DIR"
LINK_NAME="$(basename "$SRC")"
ln -sf "$ABS" "$DOCS_DIR/$LINK_NAME"

# URL-encode the query value (spaces etc.) with python.
ENCODED="$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" ".mdview-docs/$LINK_NAME")"
URL="http://localhost:$PORT/index.html?src=$ENCODED"

# Start the server if it isn't already running on this port. Detach it fully
# (nohup + disown) so it survives after this script returns to your prompt.
if ! curl -s -o /dev/null "http://localhost:$PORT/index.html" 2>/dev/null; then
  cd "$APP_DIR"
  nohup python3 -m http.server "$PORT" >/dev/null 2>&1 &
  SERVER_PID=$!
  disown "$SERVER_PID" 2>/dev/null || true
  # Give it a moment to bind.
  sleep 0.5
  echo "Serving Markdown Viewer at http://localhost:$PORT (pid $SERVER_PID)"
  echo "To stop it:  kill $SERVER_PID"
else
  echo "Reusing server already running at http://localhost:$PORT"
  echo "To stop it:  kill \$(lsof -ti tcp:$PORT)"
fi

open "$URL"
